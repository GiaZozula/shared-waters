{
  "name": "shared-water",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "import:story-ending": "tsx server/import-story-ending.ts",
    "export:story": "tsx server/export-story.ts",
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "start": "node build/server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "db:migrate": "tsx server/migrate.ts",
    "import:gfw": "tsx server/import-gfw.ts",
    "import:story-navwarn": "tsx server/import-story-navwarn.ts",
    "test:ais": "node --import tsx --test server/ais.test.ts",
    "test:ais-store": "node --import tsx --test server/ais-store.test.ts",
    "test:live": "node --import tsx --test client/live-refresh.test.ts client/adapt-now-reads.test.ts server/ais-session.test.ts server/ais.test.ts server/database.test.ts",
    "probe:ais-gulf": "tsx server/ais-gulf-probe.ts",
    "test:gfw": "tsx --test server/gfw.test.ts",
    "test:database": "tsx --test server/database.test.ts",
    "refresh:marine": "tsx server/refresh-marine.ts",
    "test:marine": "tsx --test server/marine.test.ts",
    "refresh:whoi": "tsx server/refresh-whoi.ts",
    "refresh:navwarn": "tsx server/refresh-navwarn.ts",
    "test:feeds": "tsx --test server/whoi.test.ts server/navwarn.test.ts",
    "test:feed-store": "tsx --test server/feeds-store.test.ts",
    "test:domain": "tsx --test server/domain-queries.test.ts server/domain-routes.test.ts",
    "test:domain-store": "tsx --test server/domain-store.test.ts",
    "test:agent": "tsx --test server/agent.test.ts",
    "test:replay": "node --import tsx --test client/replay-model.test.ts client/adapt-story-replay.test.ts client/adapt-now-reads.test.ts client/ask-scene.test.ts client/preset-questions.test.ts client/zone-frame.test.ts server/replay.test.ts",
    "test:replay-store": "node --import tsx --test server/replay-store.test.ts",
    "test:agent-store": "tsx --test server/agent-store.test.ts",
    "test:agent-live": "tsx --test server/agent-live.test.ts",
    "test:question": "node --import tsx --test server/agent.test.ts server/question-scope.test.ts server/question-routes.test.ts server/ai-budget.test.ts",
    "test:ai-budget-store": "node --import tsx --test server/ai-budget-store.test.ts",
    "test:observability": "node --import tsx --test server/observability.test.ts",
    "test:protection": "node --import tsx --test server/api-protection.test.ts server/ais-session.test.ts server/database.test.ts",
    "test:protection-store": "node --import tsx --test server/database-runtime.test.ts server/ais-capacity-store.test.ts server/ais-store.test.ts server/ais-collector.test.ts server/api-protection-network.test.ts",
    "test:question-store": "node --import tsx --test server/question-coverage-store.test.ts",
    "build": "npm run check && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:store": "node scripts/run-tests.mjs store",
    "test:compiled": "node --test scripts/compiled-smoke.test.mjs",
    "backup:create": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "backup:rehearse": "node scripts/backup.mjs rehearse",
    "test:backup": "node --import tsx --test scripts/backup.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "dotenv": "^16.6.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "suncalc": "^2.0.2",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.0",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
