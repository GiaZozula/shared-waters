DATABASE_URL=postgres://localhost:5432/shared_water
# Optional migration-only owner credential. Never install it on the public app host.
# MIGRATION_DATABASE_URL=postgres://localhost:5432/shared_water
# Existing dedicated runtime login, used only when applying reviewed table grants.
# RUNTIME_DATABASE_ROLE=shared_water_runtime
# One codebase: api serves requests only; worker owns collectors; all is the default.
ROLE=all
# Required by collection-enabled all/worker: a DIRECT connection using the same
# restricted runtime login/database as DATABASE_URL (never migration credentials).
# Transaction-pooler URLs are unsuitable for session advisory locks.
COORDINATION_DATABASE_URL=postgres://localhost:5432/shared_water
PORT=3001
# Local default stays off. Keep paid questions disabled unless deliberately configured.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Fail closed: key alone cannot enable paid questions. Set all limits deliberately.
AI_QUESTIONS_ENABLED=false
AI_CLIENT_CALLS=5
AI_CLIENT_WINDOW_SECONDS=600
AI_SITE_CALLS=50
AI_SITE_WINDOW_SECONDS=3600
AI_CONCURRENCY=2
# Lifetime admitted calls, including failures; no automatic reset.
AI_TOTAL_CALLS=250
# Private random secret, at least 32 characters; never send to the browser.
AI_IDENTITY_SECRET=
# Only needed for a future GFW API fetch; the checked snapshot imports from local JSON.
GFW_API_ACCESS_TOKEN=
# Server-side AISStream collector. Required for Live vessel positions.
AISSTREAM_API_KEY=
# On-demand connects while visitors read AIS, stopping two minutes after the last read.
# Use always only on a host/database budget that supports continuous collection.
AIS_COLLECTION_MODE=on-demand

# Set false only for offline checks/data-only operation: disables feed polling and AIS.
COLLECTION_ENABLED=false

# Public frontend build setting. Empty uses the existing same-origin API/proxy.
# Example external API: https://api.example.com
VITE_API_BASE=
# Exact browser origins, comma-separated. No wildcard or automatic preview access.
# Example hosted UI: https://app.example.com
# Omit locally to allow the existing origin and localhost/127.0.0.1 Vite on 5173.
# API_ALLOWED_ORIGINS=

# Optional server-only outbound metrics; off unless explicitly enabled.
# Use the exact Grafana Cloud OTLP metrics URL from the stack's OpenTelemetry tile.
# No public scrape endpoint, scheduled origin checks, or browser credentials.
METRICS_EXPORT_ENABLED=false
# METRICS_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp/v1/metrics
# METRICS_OTLP_AUTHORIZATION=Basic <base64(instance-id:metrics-write-token)>
# Unique fixed slot matching ROLE: all-1, api-1/api-2, worker-1/worker-2.
# METRICS_INSTANCE=all-1
